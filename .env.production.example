# Copy to .env.production and fill in. Used for both compose variable
# substitution (--env-file) and container runtime env (env_file).
# NEVER commit the real .env.production.

# --- Domain / TLS (Caddy) ---
DOMAIN=lumiris.com.br
ACME_EMAIL=voce@lumiris.com.br

# --- Postgres (db service) ---
POSTGRES_USER=lume
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lume

# --- App database connection (must match the Postgres vars above) ---
# Host is the compose service name "db", port 5432.
DATABASE_URL=postgres://lume:troque-esta-senha@db:5432/lume

# --- Clerk (auth) ---
# The publishable key is inlined into the client bundle at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# --- App URL (used for canonical/redirects) ---
NEXT_PUBLIC_APP_URL=https://lumiris.com.br

# --- OpenAI (transcription + SOAP). Leave LUME_AI_MOCK=true to run without a key. ---
OPENAI_API_KEY=sk-xxx
LUME_AI_MOCK=false

# --- Resend (emails transacionais). Sem chave, o envio vira no-op com log. ---
# Crie em resend.com, verifique o domínio lumiris.com.br, e use um remetente verificado.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=oi@lumiris.com.br

# --- Sentry: keep disabled for a clean first deploy; set to empty to enable ---
NEXT_PUBLIC_SENTRY_DISABLED=true

# --- Optional integrations (leave unset if unused) ---
# ARCJET_KEY=ajkey_xxx
# WOOVI_APP_ID=
# WOOVI_BASE_URL=
# WOOVI_WEBHOOK_PUBLIC_KEY=
# LUME_BILLING_MOCK=true
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
# NEXT_PUBLIC_BETTER_STACK_INGESTING_HOST=
